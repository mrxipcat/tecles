# URL de connexió a la base de dades. En local: SQLite.
# En producció (Azure): cadena de connexió a Azure SQL Database via el dialecte
# pur Python "mssql+pytds" (vegeu la secció "Desplegament a Azure" del README),
# p. ex. mssql+pytds://usuari:contrasenya@servidor.database.windows.net:1433/bd
DATABASE_URL=sqlite:///./webaules.db

# Origen permès per CORS (frontend Vite en desenvolupament)
FRONTEND_ORIGIN=http://localhost:5173
